{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Freddy",
  "version": "0.6.0",
  "identifier": "io.github.marcelao98.freddy",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "O som da mesa de RPG",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Marcelo",
    "longDescription": "Painel de som para mesas de RPG: peça músicas em português, monte playlists e troque a plumagem do Frederico.",
    "externalBin": [
      "binaries/freddy-backend"
    ],
    "linux": {
      "rpm": {
        "depends": [
          "/usr/bin/ffmpeg",
          "libopus.so.0()(64bit)",
          "libportaudio.so.2()(64bit)"
        ]
      },
      "deb": {
        "depends": [
          "ffmpeg",
          "libopus0",
          "libportaudio2"
        ]
      }
    }
  }
}
